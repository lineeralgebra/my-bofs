alias enum_groups {
    local('$bid $barch $handle $data $args $target $domain');
    $bid = $1;

    # Target and domain arguments
    $target = "all";
    $domain = "";

    if (size(@_) >= 2) {
        $target = $2;
    }
    if (size(@_) >= 3) {
        $domain = $3;
    }

    # Determine architecture
    $barch = barch($bid);

    # Read the BOF file
    $handle = openf(script_resource("enum_groups.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack arguments (zz = zero-terminated string, zero-terminated string)
    $args = bof_pack($bid, "zz", $target, $domain);

    # Execute
    btask($bid, "Running enum_groups BOF by @lineeralgebra\n  Target/Filter: $target\n  Domain: " . ($domain ? $domain : "auto-discover"));
    beacon_inline_execute($bid, $data, "go", $args);
}
